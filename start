-- GROUPING
local function getTag(p)
    if p.mega_neon then return "[MR]" end
    if p.neon then return "[N]" end
    if p.flyable and p.rideable then return "[FR]" end
    if p.flyable then return "[F]" end
    if p.rideable then return "[R]" end
    return "[NP]"
end

local grouped = {}
for _, pet in ipairs(hits) do
    local key =
        pet.name .. pet.value ..
        (pet.props.mega_neon and "mn" or "") ..
        (pet.props.neon and "n" or "") ..
        (pet.props.flyable and "f" or "") ..
        (pet.props.rideable and "r" or "")

    grouped[key] = grouped[key] or {
        name = pet.name,
        value = pet.value,
        count = 0,
        tag = getTag(pet.props)
    }
    grouped[key].count += 1
end

local groupedList = {}
for _, v in pairs(grouped) do table.insert(groupedList, v) end

-- SORT BY TOTAL VALUE (value × count)
table.sort(groupedList, function(a,b)
    return (tonumber(a.value) * a.count) > (tonumber(b.value) * b.count)
end)

