---- VALUE TABLES
local tbl_15_upvr = {
    common = 1;
    uncommon = 2;
    rare = 4;
    ultra_rare = 10;
    legendary = 26;
}

local tbl_35_upvr = { pets = 1 }

local tbl_28_upvr = {
    neon = 4;
    mega_neon = 16;
    flyable = 2;
    rideable = 2;
}

-- VALUE FUNCTION
local function getPetValueByTable(petData, props)
    if not petData or not petData.rarity then return 0 end

    local base = tbl_15_upvr[string.lower(petData.rarity)] or 0
    local bonus = 0

    for k, v in pairs(tbl_28_upvr) do
        if props[k] then bonus += v end
    end

    return (base + bonus) * (tbl_35_upvr.pets or 1)
end

